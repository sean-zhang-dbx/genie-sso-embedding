# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are exposed to the browser
# (that's expected for a SPA — the client id / tenant / group id are not secrets).

# --- Entra app registration (MSAL) ---
NEXT_PUBLIC_CLIENT_ID=<entra-app-client-id>
NEXT_PUBLIC_TENANT_ID=<entra-tenant-id>
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Group the user must belong to (Graph group-membership gate)
NEXT_PUBLIC_ALLOWED_GROUP_ID=<allowed-security-group-object-id>

# Azure Databricks resource scope (rarely changed)
NEXT_PUBLIC_DBX_SCOPE=2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default

# --- Target Genie space (for the iframe + /aad/auth bootstrap) ---
NEXT_PUBLIC_GENIE_WS_HOST=adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net
NEXT_PUBLIC_GENIE_ORG_ID=<workspace-org-id>
NEXT_PUBLIC_GENIE_SPACE_ID=<genie-space-id>
