# Copy to .env.local and fill in. NEXT_PUBLIC_* vars are exposed to the browser
# (that's expected for a SPA — the client id / tenant / group id are not secrets).

# --- Entra app registration (MSAL) ---
NEXT_PUBLIC_CLIENT_ID=<entra-app-client-id>
NEXT_PUBLIC_TENANT_ID=<entra-tenant-id>
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Group the user must belong to (Graph group-membership gate)
NEXT_PUBLIC_ALLOWED_GROUP_ID=<allowed-security-group-object-id>

# Azure Databricks resource scope (rarely changed)
NEXT_PUBLIC_DBX_SCOPE=2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default

# --- Target Genie space (for the iframe + /aad/auth bootstrap) ---
NEXT_PUBLIC_GENIE_WS_HOST=adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net
NEXT_PUBLIC_GENIE_ORG_ID=<workspace-org-id>
NEXT_PUBLIC_GENIE_SPACE_ID=<genie-space-id>

# --- Cookie-mint mode -------------------------------------------------------
# "server" (default): seamless server-side OAuth redirect chain (needs the
#   DBX_* server vars below + a Databricks account-admin OAuth app registration).
# "popup": client-only popup bootstrap; no server vars / no OAuth app needed.
NEXT_PUBLIC_MINT_MODE=server

# --- Server-side genie_sso (ONLY for NEXT_PUBLIC_MINT_MODE=server) -----------
# These are NOT NEXT_PUBLIC_* — they stay server-side. DBX_CLIENT_SECRET must
# never reach the browser. Values come from registering this app as a custom
# OAuth app integration on the Databricks account (account-admin task).
DBX_CLIENT_ID=<databricks-oauth-app-client-id>
DBX_CLIENT_SECRET=<databricks-oauth-app-secret>
# Must match the OAuth integration's redirect URL and point at the callback route:
DBX_REDIRECT_URI=http://localhost:3000/api/callback2
# HMAC key for signing the session + PKCE cookies (use a long random string):
SESSION_SECRET=<long-random-string>
# Workspace/org/space default to the NEXT_PUBLIC_GENIE_* values above; override
# here only if the server should target a different workspace than the client.
# DBX_WS_HOST=
# DBX_ORG_ID=
# DBX_SPACE_ID=
# DBX_SCHEME=https      # set http only for local non-TLS testing
# DBX_SUCCESS_REDIRECT=/  # where callback2 returns the user
