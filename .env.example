# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Signs the app's own session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Entra app registration (used by v2/v3 comparison flows) ---------------
TENANT_ID=<entra-tenant-guid>
CLIENT_ID=<entra-app-client-id>
CLIENT_SECRET=<entra-app-client-secret>
REDIRECT_URI=https://<your-app-host>/callback

# --- Target Genie Space for the v2/v3 comparison flows ---------------------
WS_HOST=adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net   # no https://
ORG_ID=<workspace-org-id>                             # the ?o= value
SPACE_ID=<genie-space-id>

# ===========================================================================
# v0 — the zero-popup SSO flow (the point of this repo).
# These come from registering THIS app as a Databricks custom OAuth app
# integration on the account (see README). If any are blank, /v0 shows
# "Not configured" and only the comparison flows run.
# ===========================================================================
SSO_WS_HOST=adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net   # no https://
SSO_ORG_ID=<workspace-org-id>
SSO_SPACE_ID=<genie-space-id>
DBX_CLIENT_ID=<databricks-oauth-client-id>
DBX_CLIENT_SECRET=<databricks-oauth-client-secret>
SSO_REDIRECT_URI=https://<your-app-host>/callback2       # must be registered as a redirect URL on the OAuth integration
